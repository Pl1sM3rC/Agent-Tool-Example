# Copy this file to .env and fill in your values: cp .env.example .env

# --- LLM endpoint (any OpenAI-compatible API, see create_model() in agent.py) ---
# DeepSeek (default)
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-flash"
LLM_API_KEY="your-key-here"
# OpenAI:    LLM_BASE_URL="https://api.openai.com/v1"      LLM_MODEL=<model id>
# LM Studio: LLM_BASE_URL="http://localhost:1234/v1"       LLM_MODEL=<model loaded in LM Studio>  (no key needed)
# Ollama:    LLM_BASE_URL="http://localhost:11434/v1"      LLM_MODEL=<pulled model, e.g. from `ollama list`> (no key needed)

# --- RAG / vector store (optional, defaults shown; relative paths are relative to this folder) ---
# VECTOR_DB_PATH="data/vector_store.db"
# Changing the embedding model requires a new VECTOR_DB_PATH (or re-embedding everything),
# because vectors from different models are not comparable.

# Any OpenAI-compatible /v1/embeddings endpoint (hosting options: see the README).
# Default: EmbeddingGemma-2 served by llama.cpp (llama-server) as "embed-mm"
# EMBEDDING_BASE_URL="http://localhost:8080/v1"
# EMBEDDING_MODEL="embed-mm"
# EMBEDDING_API_KEY="not-needed"
# Task prefixes the model expects (defaults are EmbeddingGemma-2's; set to "" for models without prefixes)
# EMBEDDING_QUERY_PREFIX="task: search result | query: "
# EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
# Ollama:    EMBEDDING_BASE_URL="http://localhost:11434/v1"  EMBEDDING_MODEL="embeddinggemma"
# LM Studio: EMBEDDING_BASE_URL="http://localhost:1234/v1"   EMBEDDING_MODEL=<id from /v1/models>
# Qwen3-Embedding instead (served as "embed"):
# EMBEDDING_MODEL="embed"
# EMBEDDING_QUERY_PREFIX="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "
# EMBEDDING_DOCUMENT_PREFIX=""
